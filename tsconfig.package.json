{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "./dist",
    "noEmitOnError": true
  },
  "include": [
    "types.ts",
    "CapabilityTokenManager.ts",
    "DeterministicCpuScorer.ts",
    "ProgressiveRegistry.ts",
    "index.ts",
    "ai/types.ts",
    "ai/BekkoSemanticScorer.ts",
    "ai/index.ts"
  ]
}
